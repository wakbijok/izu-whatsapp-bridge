# Copy to .env (chmod 600). Never commit .env.

# --- required ---
# Phone number(s) allowed to use the bot: country code, no +, comma-separated
WA_ALLOWED_USERS=

# --- WhatsApp transport (vendored Baileys bridge) ---
# bot = dedicated number paired via scripts/pair.sh; self-chat = your own number
WA_MODE=bot
WA_BRIDGE_PORT=3100
WA_BRIDGE_HOST=127.0.0.1
WA_SESSION_DIR=data/wa-session
# WA_POLL_INTERVAL=0.8
# WA_REPLY_PREFIX=

# --- Claude Code auth ---
# Subscription auth: run `claude setup-token` and put the token here, or rely on
# the machine's `claude` login. ANTHROPIC_API_KEY is deliberately ignored.
# CLAUDE_CODE_OAUTH_TOKEN=

# --- Claude Code session ---
BRIDGE_CWD=~
BRIDGE_MODEL=claude-fable-5-1
BRIDGE_FALLBACK_MODEL=claude-sonnet-4-6
# low | medium | high | xhigh | max
BRIDGE_EFFORT=medium
# default = only read-only tools are auto-allowed (WhatsApp has no approval buttons);
# bypassPermissions = unrestricted tool use
PERMISSION_MODE=default
# BRIDGE_MAX_BUFFER_SIZE=16777216

# --- deployment identity (keep out of the repo) ---
# BRIDGE_SYSTEM_PROMPT_FILE=config/persona.local.md
# BRIDGE_MCP_SERVERS_FILE=config/mcp.local.json
# BRIDGE_USER_NAME=
# BRIDGE_COMPANION_BOT=Telegram @your_other_bot

# --- timing ---
# 0 = use BRIDGE_HARD_TIMEOUT
TURN_TIMEOUT=0
# seconds, measured from your latest message
BRIDGE_HARD_TIMEOUT=3600
# seconds without any activity -> interrupt
BRIDGE_IDLE_TIMEOUT=1200
# seconds before a "still working" message; 0 = typing indicator only
PROGRESS_AFTER=0
HEARTBEAT_EVERY=240

# --- per-number profiles (guests get an isolated session: own persona, cwd,
# permissions, MCP servers / memory tenant; see claude_wa/profiles.py) ---
# BRIDGE_PROFILES_FILE=config/profiles.local.json

# create_image filesystem jail via bubblewrap: require (default) | auto | off
# BRIDGE_IMAGES_JAIL=require
# Dedicated ChatGPT login for image runs (keeps the owner's credential out of guest-steered runs)
# BRIDGE_IMAGES_AUTH_FILE=
